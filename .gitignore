# ==========================================
# Python
# ==========================================
# Виртуальное окружение
.venv/
venv/
env/
ENV/

# Байт-код и кэш Python
__pycache__/
*.py[cod]
*$py.class

# Файлы, создаваемые инструментами тестирования и сборки
.pytest_cache/
.coverage
.coverage.*
htmlcov/
build/
dist/
*.egg-info/
.eggs/

# ==========================================
# Конфигурация и секреты
# ==========================================
# Локальные переменные окружения (пароли, ключи)
.env
.env.local
.env.*.local

# ==========================================
# Docker
# ==========================================
# Если будете использовать volumes для БД локально
pgdata/
postgres-data/

# ==========================================
# Редакторы и IDE
# ==========================================
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# PyCharm / IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# ==========================================
# Операционная система
# ==========================================
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# ==========================================
# Логи и временные файлы
# ==========================================
*.log
*.tmp